{
  "name": "every-frame-first-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Every Frame First Studio — private-by-default photo editing",
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "npm run build:video-studio && tsc -b && vite build --config vite.config.ts",
    "build:video-studio": "node scripts/build-video-studio.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "test:watch": "vitest tests",
    "test:coverage": "vitest run tests --coverage",
    "build:analyze": "ANALYZE=true npm run build",
    "format": "prettier --write src/App.tsx src/main.tsx src/pages/Home.tsx src/components src/lib/aiService.ts src/lib/imageProcessor.ts src/lib/manualEditing.ts src/lib/storage.ts tests server index.html public README.md .github/workflows/deploy.yml tsconfig.json tsconfig.node.json vite.config.ts package.json",
    "format:check": "prettier --check src/App.tsx src/main.tsx src/pages/Home.tsx src/components src/lib/aiService.ts src/lib/imageProcessor.ts src/lib/manualEditing.ts src/lib/storage.ts tests server index.html public README.md .github/workflows/deploy.yml tsconfig.json tsconfig.node.json vite.config.ts package.json",
    "gateway": "node --env-file-if-exists=.env server/ai-gateway.mjs",
    "guest-signal": "node --env-file-if-exists=.env server/guest-signal.mjs"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.59",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "cropperjs": "^1.7.0",
    "fabric": "^7.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^13.2.0",
    "html2canvas": "^1.4.1",
    "immer": "^10.0.0",
    "jose": "^6.2.15",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.1",
    "lucide-react": "^1.59.0",
    "pixi.js": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.3",
    "ws": "^8.22.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/cropperjs": "^1.1.5",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
