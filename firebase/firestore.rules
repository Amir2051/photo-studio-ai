rules_version = '2';
// Minu Studio — Firestore rules (photo-editor-rz project).
// Client galleries live in galleryShares. Anyone holding the unguessable share
// link can read; only the signed-in owner can create, update, or delete.
service cloud.firestore {
  match /databases/{database}/documents {
    match /galleryShares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.photos is list
        && request.resource.data.expiresAt is string;
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
    // Everything else stays locked down unless rules are explicitly extended.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
