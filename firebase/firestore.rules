rules_version = '2';
// Minu Studio — Firestore rules (deploy in the photo-editor-rz project).
// Client galleries live in galleryShares. Photos leave the app only through
// share links the photographer creates; anyone holding the unguessable id can
// read, only the owner can create/update/delete.
service cloud.firestore {
  match /databases/{database}/documents {
    match /galleryShares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.photos is list
        && request.resource.data.expiresAt is string;
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
    // Everything else stays locked down unless rules are explicitly extended.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
