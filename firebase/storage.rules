rules_version = '2';
// Minu Studio — Firebase Storage rules (deploy in the photo-editor-rz project).
// Gallery uploads: authenticated users only, images only, 25 MB cap.
// Reads are public-by-link (unguessable share id in the path); do not store
// anything private outside gallery-shares/.
service firebase.storage {
  match /b/{bucket}/o {
    match /gallery-shares/{shareId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
