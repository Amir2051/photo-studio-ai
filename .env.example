# Client configuration: Supabase (public-by-design keys).
VITE_SUPABASE_URL=https://texgwxmizyxsdzcfsjpo.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_fBFeavpYj1CI4L-lTAVj2Q_V41qHK2Z

# Local server-only configuration. Copy to .env; never prefix secrets with VITE_.
AI_GATEWAY_HOST=127.0.0.1
AI_GATEWAY_PORT=18787
AI_GATEWAY_PROXY_TARGET=http://127.0.0.1:18787
APP_URL=http://127.0.0.1:5173

# Supabase access-token verification for the server-side AI gateway and MIA proxy.
AUTH_JWKS_URL=https://texgwxmizyxsdzcfsjpo.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://texgwxmizyxsdzcfsjpo.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated

# Server-side OpenRouter credentials and model allowlist.
OPENROUTER_API_KEY=
AI_DEFAULT_MODEL=
AI_ALLOWED_MODELS=

# Local-only WebRTC guest room signaling service (no media is routed through this service).
GUEST_SIGNAL_HOST=127.0.0.1
GUEST_SIGNAL_PORT=18788
GUEST_SIGNAL_PROXY_TARGET=http://127.0.0.1:18788
GUEST_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Optional TURN relay credentials (configure only on the server; do not commit secrets).
GUEST_TURN_URLS=
GUEST_TURN_USERNAME=
GUEST_TURN_SHARED_SECRET=
GUEST_TURN_CREDENTIAL_TTL=3600

# Public HTTPS origin of the hosted guest signaling service (leave blank for same-origin local development).
VITE_GUEST_SIGNAL_URL=

# MIA uses the Studio-owned proxy and central OpenRouter gateway. No RZ Agent URL or legacy service key is used.
STUDIO_ALLOWED_ORIGINS=https://every-frame-first-studio.onrender.com,https://studio.safenestt.com
MIA_RATE_LIMIT_PER_MINUTE=20
