# Firebase web app configuration (client-side identifiers; Firebase security rules remain essential).
VITE_FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=photo-editor-rz.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=photo-editor-rz
VITE_FIREBASE_STORAGE_BUCKET=photo-editor-rz.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=201123663761
VITE_FIREBASE_APP_ID=1:201123663761:web:da004d64b015ad95531430
VITE_FIREBASE_MEASUREMENT_ID=G-D3LFWSJ6D9

# Local server-only configuration. Copy to .env; never prefix secrets with VITE_.
AI_GATEWAY_HOST=127.0.0.1
AI_GATEWAY_PORT=18787
AI_GATEWAY_PROXY_TARGET=http://127.0.0.1:18787
APP_URL=http://127.0.0.1:5173

# Firebase ID token verification for the server-side AI gateway.
AUTH_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
AUTH_ISSUER=https://securetoken.google.com/photo-editor-rz
AUTH_AUDIENCE=photo-editor-rz

# Server-side OpenRouter credentials and model allowlist.
OPENROUTER_API_KEY=
AI_DEFAULT_MODEL=
AI_ALLOWED_MODELS=

# Local-only WebRTC guest room signaling service (no media is routed through this service).
GUEST_SIGNAL_HOST=127.0.0.1
GUEST_SIGNAL_PORT=18788
GUEST_SIGNAL_PROXY_TARGET=http://127.0.0.1:18788
GUEST_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Optional TURN relay credentials (configure only on the server; do not commit secrets).
GUEST_TURN_URLS=
GUEST_TURN_USERNAME=
GUEST_TURN_SHARED_SECRET=
GUEST_TURN_CREDENTIAL_TTL=3600

# Public HTTPS origin of the hosted guest signaling service (leave blank for same-origin local development).
VITE_GUEST_SIGNAL_URL=
